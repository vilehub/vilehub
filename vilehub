local function getClosestPlayer()
    local mc = lp.Character
    if not mc or not mc:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
    local mr = mc.HumanoidRootPart
    local closest = nil
    local closestDist = math.huge

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local tr = pl.Character.HumanoidRootPart
            local d = (tr.Position - mr.Position).Magnitude
            if d < closestDist then
                closestDist = d
                closest = pl
            end
        end
    end
    return closest, closestDist
end

local function startAutoguardVL()
    if autoConnection then autoConnection:Disconnect() end
    vlEnabled = true

    autoConnection = RunService.Heartbeat:Connect(function()
        local mc = lp.Character
        if not mc or not mc:FindFirstChild("Humanoid") or not mc:FindFirstChild("HumanoidRootPart") then return end

        local target, dist = getClosestPlayer()
        if not target or not target.Character then return end

        local tc = target.Character
        local h = mc.Humanoid
        local mr = mc.HumanoidRootPart
        local tr = tc:FindFirstChild("HumanoidRootPart")
        if not tr then return end

        local pos
        if dist <= pd then
            pos = tr.Position + tr.Velocity * pf
        else
            pos = tr.Position
        end

        h:MoveTo(pos)
    end)
end

local function stopAutoguardVL()
    if autoConnection then
        autoConnection:Disconnect()
        autoConnection = nil
    end
    vlEnabled = false
end

