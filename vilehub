local function createAnimatedToggle(parent, pos, defaultOn)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 48, 0, 26)
    frame.Position = pos
    frame.BackgroundColor3 = defaultOn and Color3.fromRGB(140, 90, 255) or Color3.fromRGB(55, 52, 65)
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 20, 0, 20)
    circle.Position = defaultOn and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Parent = frame
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local state = defaultOn

    local function setState(newState)
        state = newState
        TweenService:Create(frame, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = state and Color3.fromRGB(140, 90, 255) or Color3.fromRGB(55, 52, 65)}):Play()
        TweenService:Create(circle, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)}):Play()
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setState(not state)
        end
    end)

    return frame, circle, setState, function() return state end
end

local function createKeybindButton(parent, pos, onKeyChanged)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 0, 26)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(35, 32, 45)
    btn.Text = "Set Keybind"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.Gotham
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local currentKey = nil
    local listening = false

    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "Press key..."

        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                currentKey = input.KeyCode
                btn.Text = currentKey.Name
                listening = false
                if onKeyChanged then onKeyChanged(currentKey) end
                conn:Disconnect()
            end
        end)
    end)

    return btn, function() return currentKey end
end

